// Транспортная основа внешней обработки DragonZap для 1С:УТ 11.
// Процедуры создания документов намеренно требуют адаптации к релизу тестовой базы.

Перем АдресСервера;
Перем ПортСервера;
Перем ИспользоватьHTTPS;
Перем ЛогинОбмена;
Перем ПарольОбмена;

Функция СоздатьHTTPСоединение() Экспорт
    ЗащищенноеСоединение = Неопределено;
    Если ИспользоватьHTTPS Тогда
        ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
    КонецЕсли;

    Возврат Новый HTTPСоединение(
        АдресСервера,
        ПортСервера,
        ЛогинОбмена,
        ПарольОбмена,
        Неопределено,
        60,
        ЗащищенноеСоединение
    );
КонецФункции

Функция ПрочитатьJSONОтвет(HTTPОтвет) Экспорт
    Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
        ВызватьИсключение СтрШаблон(
            "DragonZap вернул HTTP %1: %2",
            HTTPОтвет.КодСостояния,
            HTTPОтвет.ПолучитьТелоКакСтроку()
        );
    КонецЕсли;

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
    Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция ЗаписатьJSONСтроку(Данные) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ПроверитьПодключение() Экспорт
    Соединение = СоздатьHTTPСоединение();
    Запрос = Новый HTTPЗапрос("/1c/outbox/v1/ping");
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Ответ = ПрочитатьJSONОтвет(Соединение.Получить(Запрос));
    Если Ответ.contract_version <> "1.0" Тогда
        ВызватьИсключение "Версия контракта DragonZap не поддерживается";
    КонецЕсли;
    Возврат Ответ;
КонецФункции

Функция ПолучитьПакет(Лимит = 100) Экспорт
    Соединение = СоздатьHTTPСоединение();
    Путь = "/1c/outbox/v1/query?limit=" + Формат(Лимит, "ЧГ=0");
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Ответ = ПрочитатьJSONОтвет(Соединение.Получить(Запрос));
    Если Ответ.protocol <> "dz-1c-outbox" Или Ответ.contract_version <> "1.0" Тогда
        ВызватьИсключение "Получен неизвестный формат пакета DragonZap";
    КонецЕсли;
    Возврат Ответ;
КонецФункции

Процедура ПодтвердитьПакет(UIDПакета, Результаты) Экспорт
    Тело = Новый Структура;
    Тело.Вставить("contract_version", "1.0");
    Тело.Вставить("results", Результаты);

    Соединение = СоздатьHTTPСоединение();
    Запрос = Новый HTTPЗапрос("/1c/outbox/v1/" + UIDПакета + "/ack");
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(ЗаписатьJSONСтроку(Тело), КодировкаТекста.UTF8);
    ПрочитатьJSONОтвет(Соединение.ВызватьHTTPМетод("POST", Запрос));
КонецПроцедуры

Функция ЗагрузитьПилотныйЖурнал() Экспорт
    Журнал = ХранилищеОбщихНастроек.Загрузить(
        "DragonZapОбмен",
        "ОбработанныеСобытия"
    );
    Если Журнал = Неопределено Тогда
        Журнал = Новый Соответствие;
    КонецЕсли;
    Возврат Журнал;
КонецФункции

Процедура СохранитьПилотныйЖурнал(Журнал) Экспорт
    ХранилищеОбщихНастроек.Сохранить(
        "DragonZapОбмен",
        "ОбработанныеСобытия",
        Журнал
    );
КонецПроцедуры

Функция УспешныйРезультат(Событие, ВнешнийИдентификатор) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("event_uid", Событие.event_uid);
    Результат.Вставить("success", Истина);
    Результат.Вставить("external_id", Строка(ВнешнийИдентификатор));
    Возврат Результат;
КонецФункции

Функция ОшибочныйРезультат(Событие, ТекстОшибки) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("event_uid", Событие.event_uid);
    Результат.Вставить("success", Ложь);
    Результат.Вставить("error", Лев(ТекстОшибки, 4000));
    Возврат Результат;
КонецФункции

Функция СоздатьИлиОбновитьДокумент(Событие) Экспорт
    Если Событие.event_type = "cancelled" Тогда
        Возврат ОтменитьПроведениеДокумента(Событие);
    ИначеЕсли Событие.entity_type = "shipment" Тогда
        Возврат СоздатьРеализациюТоваровУслуг(Событие.payload);
    ИначеЕсли Событие.entity_type = "supplier_receipt" Тогда
        Возврат СоздатьПриобретениеТоваровУслуг(Событие.payload);
    ИначеЕсли Событие.entity_type = "stock_document" Тогда
        Возврат СоздатьСкладскойДокумент(Событие.payload);
    ИначеЕсли Событие.entity_type = "production_wave" Тогда
        Возврат СоздатьСборкуТоваров(Событие.payload);
    КонецЕсли;
    ВызватьИсключение "Неизвестный тип события: " + Событие.entity_type;
КонецФункции

Процедура ВыполнитьОбмен() Экспорт
    Пакет = ПолучитьПакет();
    Если Пакет.batch_uid = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Журнал = ЗагрузитьПилотныйЖурнал();
    НовыйЖурнал = Новый Соответствие;
    Для Каждого ЭлементЖурнала Из Журнал Цикл
        НовыйЖурнал.Вставить(ЭлементЖурнала.Ключ, ЭлементЖурнала.Значение);
    КонецЦикла;
    Результаты = Новый Массив;

    Для Каждого Событие Из Пакет.events Цикл
        ИдентификаторИзЖурнала = НовыйЖурнал.Получить(Событие.idempotency_key);
        Если ИдентификаторИзЖурнала <> Неопределено Тогда
            Результаты.Добавить(
                УспешныйРезультат(Событие, ИдентификаторИзЖурнала)
            );
            Продолжить;
        КонецЕсли;

        НачатьТранзакцию();
        Попытка
            СсылкаДокумента = СоздатьИлиОбновитьДокумент(Событие);
            ЗафиксироватьТранзакцию();
            ВнешнийИдентификатор = XMLСтрока(СсылкаДокумента);
            НовыйЖурнал.Вставить(Событие.idempotency_key, ВнешнийИдентификатор);
            Результаты.Добавить(УспешныйРезультат(Событие, ВнешнийИдентификатор));
        Исключение
            ОтменитьТранзакцию();
            Результаты.Добавить(ОшибочныйРезультат(Событие, ОписаниеОшибки()));
        КонецПопытки;
    КонецЦикла;

    // Сначала сохраняем локальные ключи, затем подтверждаем пакет платформе.
    // При сетевой ошибке следующий запуск найдёт документы по этим ключам.
    СохранитьПилотныйЖурнал(НовыйЖурнал);
    ПодтвердитьПакет(Пакет.batch_uid, Результаты);
КонецПроцедуры

Функция СоздатьРеализациюТоваровУслуг(Данные) Экспорт
    ВызватьИсключение "Нужно настроить создание реализации под релиз тестовой УТ 11";
КонецФункции

Функция СоздатьПриобретениеТоваровУслуг(Данные) Экспорт
    ВызватьИсключение "Нужно настроить создание приобретения под релиз тестовой УТ 11";
КонецФункции

Функция СоздатьСкладскойДокумент(Данные) Экспорт
    ВызватьИсключение "Нужно настроить складские документы под релиз тестовой УТ 11";
КонецФункции

Функция СоздатьСборкуТоваров(Данные) Экспорт
    ВызватьИсключение "Нужно настроить сборку товаров под релиз тестовой УТ 11";
КонецФункции

Функция ОтменитьПроведениеДокумента(Событие) Экспорт
    ВызватьИсключение "Нужно настроить отмену проведения под релиз тестовой УТ 11";
КонецФункции
