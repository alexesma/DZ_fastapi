# ============================================================================
# DZ_fastapi — чек-лист переменных окружения
# ============================================================================
# Скопируйте в .env (docker compose подхватывает env_file) и заполните.
# Обязательные для старта помечены [ОБЯЗАТЕЛЬНО], остальные имеют дефолты.
# ============================================================================


# ─── 1. База данных ─────────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] Строка подключения к PostgreSQL (asyncpg).
# Формат: postgresql+asyncpg://пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql+asyncpg://dz_user:CHANGE_ME@db:5432/dz_fastapi

# [ОБЯЗАТЕЛЬНО] БД для pytest (одноразовый Postgres на 55432 локально).
TEST_DATABASE_URL=postgresql+asyncpg://test:test@127.0.0.1:55432/testdb

# Пул соединений (дефолты обычно достаточны).
#DATABASE_POOL_SIZE=10
#DATABASE_MAX_OVERFLOW=20
#DATABASE_POOL_TIMEOUT=30
#DATABASE_CONNECT_TIMEOUT=10


# ─── 2. Безопасность ────────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] Секрет подписи JWT-токенов, cookie 1С-обмена и
# OAuth-state Диадока. Сгенерировать: openssl rand -hex 32
# НЕ оставляйте дефолт "change-me" в проде!
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32


# ─── 3. Почта: приём прайсов и заказов (IMAP) ───────────────────────────────
# Три ящика: прайсы поставщиков, заказы клиентов, общий/аналитика.
# Для Яндекс.Почты: включить IMAP в настройках ящика и создать
# «пароль приложения» (Аккаунт → Безопасность → Пароли приложений).

# Ящик входящих прайсов поставщиков.
EMAIL_HOST_PRICE=imap.yandex.ru
EMAIL_NAME_PRICE=prices@your-domain.ru
EMAIL_PASSWORD_PRICE=app_password_here

# Ящик заказов клиентов.
EMAIL_HOST_ORDERS=imap.yandex.ru
EMAIL_NAME_ORDERS=orders@your-domain.ru
EMAIL_PASSWORD_ORDERS=app_password_here
# Папка IMAP с заказами (по умолчанию INBOX).
#EMAIL_FOLDER_ORDERS=INBOX

# Общий ящик (исходящие письма, аналитика).
EMAIL_NAME=info@your-domain.ru
EMAIL_PASSWORD=app_password_here
# Ящик-отправитель для писем с заказами поставщикам.
EMAIL_NAME_ANALYTIC=orders@your-domain.ru

# Отправка почты: smtp (по умолчанию) или resend (https://resend.com).
#EMAIL_TRANSPORT=smtp
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=465

# Если EMAIL_TRANSPORT=resend — ключ из https://resend.com/api-keys:
#RESEND_API_KEY=re_xxxxxxxx
#RESEND_FROM_EMAIL=noreply@your-domain.ru
#RESEND_API_TIMEOUT=30

# Gmail API вместо IMAP (опционально, для Google-ящиков):
# создать OAuth-приложение в Google Cloud Console → Credentials.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.ru/api/google/callback
#GOOGLE_OAUTH_REFRESH_TOKEN=
#GMAIL_API_TIMEOUT=60

# Таймауты почтовых задач планировщика.
#IMAP_FETCH_PER_ACCOUNT_TIMEOUT_SEC=90
#CUSTOMER_ORDERS_IMAP_TIMEOUT_SEC=60
#CUSTOMER_ORDERS_IMAP_RETRIES=3
#CUSTOMER_ORDERS_IMAP_RETRY_DELAY_SEC=5
#CUSTOMER_ORDERS_FETCH_LIMIT=50


# ─── 4. Сайт Dragonzap ──────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] API-ключ сайта dragonzap.ru (личный кабинет сайта /
# у разработчика сайта). Используется для поиска предложений,
# отправки заказов, трекинга статусов.
KEY_FOR_WEBSITE=CHANGE_ME

# Учётка API v3 сайта (используется сервисом заказов).
V3_USERNAME=
V3_PASSWORD=
# ID пользователя-покупателя по умолчанию на сайте (для заказов).
WEBSITE_USER_ID=2

# Кэш ответов сайта для ручного поиска (сек). 0 — выключить.
#SITE_SEARCH_CACHE_TTL_SEC=180

# Сколько заказов синхронизировать со статусами сайта за раз.
#TRACKING_SITE_SYNC_LIMIT=200

# Внешний сервис контроля цен (если развёрнут отдельно).
#API_CONTROL_BASE_URL=


# ─── 5. Диадок (Контур) ─────────────────────────────────────────────────────
# OAuth-приложение выдаёт Контур: пишете на diadoc-api@kontur.ru или
# через кабинет разработчика (developer.kontur.ru), получаете
# client_id/client_secret и регистрируете redirect_uri.

# [для ЭДО] Данные OAuth-приложения от Контура.
DIADOC_CLIENT_ID=
DIADOC_CLIENT_SECRET=
# Должен точно совпадать с зарегистрированным у Контура.
DIADOC_OAUTH_REDIRECT_URI=https://your-domain.ru/api/diadoc/oauth/callback

# Окружение по умолчанию: staging (песочница) или prod.
# Начинайте со staging, prod включайте после проверки!
DIADOC_DEFAULT_ENVIRONMENT=staging

# Адреса API (менять не нужно, только если Контур сменит домены).
#DIADOC_API_BASE_URL=https://diadoc-api.kontur.ru
#DIADOC_OIDC_BASE_URL=https://identity.kontur.ru


# ─── 6. ГИС МТ (Честный знак) ───────────────────────────────────────────────
# Вход выполняется облачной подписью Диадока (SMS), токен живёт ~10 ч.
# Сертификат Контура должен быть зарегистрирован в ЛК Честного знака.

# Прод: https://markirovka.crpt.ru/api/v3/true-api
# Песочница: https://markirovka.sandbox.crptech.ru/api/v3/true-api
# СНАЧАЛА проверьте вывод из оборота на песочнице!
GIS_MT_BASE_URL=https://markirovka.sandbox.crptech.ru/api/v3/true-api


# ─── 7. Обмен с 1С ──────────────────────────────────────────────────────────
# Стандартный протокол «Обмен с сайтом»: в 1С:УТ указывается адрес
# https://your-domain.ru/api/1c/exchange и этот логин/пароль.
# Придумайте сами (это НЕ учётка 1С, а пароль для доступа 1С к нам).

ONE_C_EXCHANGE_LOGIN=onec
ONE_C_EXCHANGE_PASSWORD=CHANGE_ME_strong_password


# ─── 8. Реквизиты организации (для писем/документов) ────────────────────────

SELLER_NAME=ООО «Ваша компания»
SELLER_INN=0000000000
SELLER_KPP=000000000
SELLER_ADDRESS=г. Москва, ...
SELLER_PHONE=+7 ...
SELLER_EMAIL=info@your-domain.ru


# ─── 9. Telegram (в РФ заблокирован — можно не заполнять) ───────────────────
# Уведомления дублируются в колокольчик приложения, поэтому TG опционален.
# Токен бота: создать через @BotFather. Chat ID: написать боту и посмотреть
# через https://api.telegram.org/bot<TOKEN>/getUpdates

#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=
#TELEGRAM_TO=
#TELEGRAM_TOKEN_MESSAGE=
# HTTP-прокси или свой relay для обхода блокировки:
#TELEGRAM_PROXY_URL=
#TELEGRAM_API_BASE=
# Виджет чата на сайте (если используется):
#TELEGRAM_WIDGET_ENABLED=0
#TELEGRAM_WIDGET_SECRET=


# ─── 10. Планировщик (интервалы задач, минуты) ──────────────────────────────
# Все имеют разумные дефолты — менять при необходимости.

# Проверка почты (входящие прайсы) — каждые N минут.
#SCHED_FETCH_INBOX_EVERY_MINUTES=10
# Заказы клиентов из почты.
#SCHED_CUSTOMER_ORDERS_EVERY_MINUTES=5
# Ответы поставщиков (подтверждения из почты).
#SCHED_SUPPLIER_RESPONSES_EVERY_MINUTES=10
# Документы поставщиков (УПД/накладные из почты).
#SCHED_SUPPLIER_DOCUMENTS_EVERY_MINUTES=15
# Синк входящих Диадока (09–18 МСК).
#SCHED_DIADOC_INBOUND_EVERY_MINUTES=15
# Статусы исходящих Диадока (09–19 МСК).
#SCHED_DIADOC_OUTBOUND_STATUS_EVERY_MINUTES=30
# Медленный опрос заказов вне ожидаемых окон.
#SCHED_ORDERS_SLOW_POLL_MINUTES=30
# Задержка старта планировщика после запуска контейнера (сек).
#SCHEDULER_STARTUP_DELAY_SECONDS=15
# Таймауты задач (сек).
#FETCH_INBOX_TASK_TIMEOUT_SEC=1200
#SUPPLIER_RESPONSES_TASK_TIMEOUT_SEC=2700
#SUPPLIER_DOCUMENTS_TASK_TIMEOUT_SEC=2700
# Параллелизм обработки прайсов (1 = последовательно, безопасно по памяти).
#PRICE_PROVIDER_PROCESS_PARALLELISM=1


# ─── 11. Автозаказ ──────────────────────────────────────────────────────────
# Ключевые ручки; полный список — в services/autopurchase.py.

# Ночной автоматический запуск (0 = выключен, запускаете вручную).
AUTOPURCHASE_NIGHT_RUN_ENABLED=0
# Целевой запас по ABC-классам (дней покрытия).
#AUTOPURCHASE_TARGET_COVER_DAYS=45
#AUTOPURCHASE_TARGET_COVER_DAYS_B=30
#AUTOPURCHASE_TARGET_COVER_DAYS_C=21
# Максимум закупки к нашей цене продажи (0.9 = закупка не дороже 90%).
#AUTOPURCHASE_MAX_PURCHASE_TO_SALE_RATIO=0.9
#AUTOPURCHASE_TARGET_PURCHASE_TO_SALE_RATIO=0.8
# Поправка спроса по наличию: множитель не выше N (защита от выбросов).
#AUTOPURCHASE_AVAILABILITY_BOOST_CAP=3
#AUTOPURCHASE_AVAILABILITY_CONFIDENCE_DAYS=14
# Кэш предложений сайта в расчёте (сек) и параллелизм запросов.
#AUTOPURCHASE_SITE_CACHE_TTL_SEC=3600
#AUTOPURCHASE_SITE_FETCH_CONCURRENCY=4
#AUTOPURCHASE_MAX_CROSS_QUERIES=8
# Контур план/факт: через сколько дней сверять прогноз с фактом.
#AUTOPURCHASE_FEEDBACK_DAYS=30
#AUTOPURCHASE_FEEDBACK_SNAPSHOT_INTERVAL_DAYS=7
# Автоотправка черновиков (осторожно! 0 пока не обкатано).
#AUTOPURCHASE_AUTO_SEND_ENABLED=0
#AUTOPURCHASE_AUTO_SEND_CUSTOMER_NAME=

# ИИ-пояснения к позициям автозаказа (опционально, OpenAI-совместимый API).
#AUTOPURCHASE_AI_ENABLED=0
#AUTOPURCHASE_AI_BASE_URL=
#AUTOPURCHASE_AI_MODEL=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
# ИИ-классификатор ответов поставщиков (опционально).
#SUPPLIER_RESPONSE_AI_CLASSIFIER_BASE_URL=
#SUPPLIER_RESPONSE_AI_CLASSIFIER_MODEL=


# ─── 12. Файлы, лимиты, хранение истории ────────────────────────────────────

# Каталог загрузок (в docker — примонтированный volume!).
#UPLOAD_DIR=/app/uploads
#CUSTOMER_ORDERS_UPLOAD_DIR=/app/uploads/customer_orders
#MAX_FILE_SIZE=52428800

# Сколько дней хранить историю (чистка ночным регламентом).
#PRICE_HISTORY_RETENTION_DAYS=365
#SUPPLIER_MSG_RETENTION_DAYS=180
#EXECUTION_TRACE_RETENTION_DAYS=30
#METRIC_SNAPSHOT_RETENTION_DAYS=90
#APP_NOTIFICATION_RETENTION_DAYS=60
#PRICE_CHECK_LOG_RETENTION_DAYS=90
#PRICELIST_STALE_ALERT_RETENTION_DAYS=30

# Порог алерта об изменении цены прайса (в процентах).
#PRICE_ALERT_THRESHOLD_PCT=10

# Watchlist: immediate — уведомлять сразу, daily — раз в день.
#WATCHLIST_NOTIFY_MODE=immediate

# Уровень логирования: DEBUG / INFO / WARNING.
#APP_LOG_LEVEL=INFO
